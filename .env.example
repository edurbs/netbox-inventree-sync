# Template for .env -- copy to .env and adjust.
# All values below are local dev defaults, not secrets.

# docker-compose.yml backing services (NetBox side)
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox
POSTGRES_DB=netbox

# NetBox API token of the seeded admin user; written by scripts/seed_netbox.py.
NETBOX_TOKEN=

# docker-compose.yml backing services (InvenTree side)
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=inventree
INVENTREE_DB_NAME=inventree

# InvenTree API token of the seeded admin user; written by scripts/setup_inventree.sh.
INVENTREE_TOKEN=
